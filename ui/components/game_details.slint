import { GameData } from "game_card.slint";

export component GameDetails inherits Rectangle {
    in property <GameData> game;
    in property <image> cover_image;

    callback close();
    callback play();
    callback edit();
    callback delete_game();

    width: 360px;
    background: #161622;
    border-width: 1px;
    border-color: #262638;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // En-tête avec bouton fermer
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "DÉTAILS DU JEU";
                font-size: 11px;
                font-weight: 800;
                color: #818cf8;
                letter-spacing: 1px;
                vertical-alignment: center;
            }
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: close_touch.has-hover ? #2e2e42 : #222232;
                Text {
                    text: "✕";
                    color: #a1a1aa;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                close_touch := TouchArea {
                    clicked => { root.close(); }
                    mouse-cursor: pointer;
                }
            }
        }

        // Grande jaquette
        Rectangle {
            height: 220px;
            border-radius: 8px;
            clip: true;
            background: #101018;

            if game.has_cover: Image {
                source: root.cover_image;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }

            if !game.has_cover: VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: "🎮";
                    font-size: 48px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Aucune jaquette cover.png";
                    font-size: 11px;
                    color: #64748b;
                    horizontal-alignment: center;
                }
            }
        }

        // Titre et métadonnées
        Text {
            text: root.game.title;
            font-size: 18px;
            font-weight: 800;
            color: #ffffff;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                background: #7c3aed33;
                border-radius: 4px;
                height: 22px;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    alignment: center;
                    Text {
                        text: root.game.platform;
                        font-size: 11px;
                        font-weight: 700;
                        color: #a78bfa;
                    }
                }
            }
            if root.game.release_year != "": Rectangle {
                background: #27273a;
                border-radius: 4px;
                height: 22px;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    alignment: center;
                    Text {
                        text: root.game.release_year;
                        font-size: 11px;
                        color: #94a3b8;
                    }
                }
            }
        }

        if root.game.developer != "": HorizontalLayout {
            spacing: 4px;
            Text {
                text: "Développeur :";
                font-size: 12px;
                color: #64748b;
            }
            Text {
                text: root.game.developer;
                font-size: 12px;
                color: #cbd5e1;
                font-weight: 600;
            }
        }

        if root.game.categories != "": HorizontalLayout {
            spacing: 4px;
            Text {
                text: "Genres :";
                font-size: 12px;
                color: #64748b;
            }
            Text {
                text: root.game.categories;
                font-size: 12px;
                color: #cbd5e1;
                wrap: word-wrap;
            }
        }

        if root.game.description != "": Rectangle {
            background: #12121a;
            border-radius: 6px;
            padding: 10px;
            Text {
                text: root.game.description;
                font-size: 12px;
                color: #94a3b8;
                wrap: word-wrap;
            }
        }

        // Chemin exécutable
        Text {
            text: "Exécutable : " + root.game.executable_path;
            font-size: 10px;
            color: #475569;
            overflow: elide;
        }

        // Séparateur élastique
        Rectangle {
            vertical-stretch: 1;
        }

        // Bouton Lancer géant
        Rectangle {
            height: 44px;
            border-radius: 6px;
            background: play_big.has-hover ? #6d28d9 : #7c3aed;

            Text {
                text: "▶ LANCER LE JEU";
                font-size: 14px;
                font-weight: 800;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            play_big := TouchArea {
                clicked => { root.play(); }
                mouse-cursor: pointer;
            }
        }

        // Boutons secondaires Modifier / Supprimer
        HorizontalLayout {
            spacing: 8px;

            Rectangle {
                height: 36px;
                horizontal-stretch: 1;
                border-radius: 6px;
                background: edit_touch.has-hover ? #2d2d40 : #20202e;
                Text {
                    text: "✏ Modifier";
                    font-size: 12px;
                    color: #e2e8f0;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                edit_touch := TouchArea {
                    clicked => { root.edit(); }
                    mouse-cursor: pointer;
                }
            }

            Rectangle {
                height: 36px;
                horizontal-stretch: 1;
                border-radius: 6px;
                background: del_touch.has-hover ? #7f1d1d : #3a151b;
                Text {
                    text: "🗑 Supprimer";
                    font-size: 12px;
                    color: #f87171;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                del_touch := TouchArea {
                    clicked => { root.delete_game(); }
                    mouse-cursor: pointer;
                }
            }
        }
    }
}
